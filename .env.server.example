# Public root URL of the ONE server hosting all four bots.
# Example: https://your-service.onrender.com
APP_BASE_URL=https://YOUR-ACTIVE-SERVER.example

# If using host dashboard environment variables instead of apps/*/.env files,
# use prefixes. Examples:
# FILTER_BOT_TOKEN=
# FILTER_DATABASE_URL=
# FIT_BOT_TOKEN=
# FIT_SUPABASE_URL=
# NIMA_BOT_TOKEN=
# NIMA_SUPABASE_URL=
# SHOP_BOT_TOKEN=
# SHOP_SUPABASE_URL=
# SHOP_SESSION_SECRET=
